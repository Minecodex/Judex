JUDEX_ENV=development
JUDEX_HTTP_ADDR=127.0.0.1:8080
JUDEX_WEB_DIR=web/dist
JUDEX_SHUTDOWN_TIMEOUT=15s
# Process mode: all | api | worker | migrate (docs/plans/v1/01)
JUDEX_MODE=all
# PostgreSQL DSN; required for all/worker/migrate modes and production
JUDEX_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/judex?sslmode=disable
# Background worker goroutines per process
JUDEX_WORKER_COUNT=2
JUDEX_LOG_LEVEL=info
# Copying this file does not automatically export variables into the process.
# Object storage (P2-04+): S3-compatible endpoint (SeaweedFS/MinIO/external)
JUDEX_S3_ENDPOINT=
JUDEX_S3_ACCESS_KEY=
JUDEX_S3_SECRET_KEY=
JUDEX_S3_BUCKET=judex
JUDEX_S3_PATH_STYLE=true
# Operator model catalog file (P5): models.yaml with baseUrl/apiKeyEnv refs
JUDEX_MODEL_CATALOG_FILE=
# Isolated preview origin for HTML material previews (P2-05); empty = no interactive preview
JUDEX_PREVIEW_ORIGIN=
