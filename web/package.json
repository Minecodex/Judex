{
  "name": "@judex/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node ../scripts/release/client-downloads.mjs dist/downloads",
    "build:demo": "tsc --noEmit && vite build --mode preview --outDir .cache/demo-dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test ../tests/web/*.test.mjs",
    "test:e2e": "playwright test --config ../tests/e2e/playwright.config.ts",
    "dev:demo": "vite --mode e2e --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.47.0",
    "marked": "^16.4.2",
    "mermaid": "12.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
