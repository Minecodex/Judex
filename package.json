{
  "name": "judex",
  "version": "0.0.1-beta",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @judex/web",
    "build": "npm run build --workspace @judex/web",
    "test:web": "npm test --workspace @judex/web",
    "test:ci": "node --test tests/ci/*.test.mjs",
    "test:e2e": "node tests/v2/local.mjs",
    "gen:api": "node api/generate.mjs && node api/generate-types.mjs",
    "release:build": "node scripts/release/build.mjs",
    "build:v2": "node web/v2-preview/build.mjs",
    "preview:v2": "node tests/v2-preview/server.mjs",
    "test:v2": "npm run build:v2 && playwright test --config tests/v2-preview/playwright.config.mjs",
    "test:v2:service": "node tests/v2/service.mjs",
    "test:v2:agents": "node tests/v2/agents.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "js-yaml": "4.1.1",
    "openapi-typescript": "7.13.0"
  },
  "dependencies": {
    "react-router": "7.5.0"
  }
}
